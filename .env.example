# Copy this file to .env.local and fill in values.  NEVER commit .env.local.
# Everything marked (optional) has a safe development fallback so you can build
# without any third-party account.

# --- Database (required) ---------------------------------------------------
# Local Docker (npm run db:up):
DATABASE_URL="postgresql://spice:spice_local_pw@localhost:5432/spice_garden?schema=public"
DIRECT_URL="postgresql://spice:spice_local_pw@localhost:5432/spice_garden?schema=public"
# Hosted (Neon / Supabase): use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL.

# --- App / Auth (required) -------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with:  openssl rand -base64 32   (or any 32+ char random string)
AUTH_SECRET=""

# Google login (optional – hidden in UI when empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- OTP / SMS (optional) --------------------------------------------------
# OTP_PROVIDER=console prints OTPs in the server terminal (development only)
OTP_PROVIDER="console"          # console | msg91 | twilio
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Email (optional) ------------------------------------------------------
EMAIL_PROVIDER="console"        # console | resend | smtp
RESEND_API_KEY=""
EMAIL_FROM="Spice Garden <orders@example.com>"

# --- Razorpay (optional until Phase 3 – use TEST keys only) ----------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Seed data -------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
